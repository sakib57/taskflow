NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://taskflow:taskflow_secret@localhost:5433/auth_db

# Redis
REDIS_URL=redis://:taskflow_redis@localhost:6380

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# RabbitMQ
RABBITMQ_URL=amqp://taskflow:taskflow_rabbit@localhost:5673/taskflow

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173