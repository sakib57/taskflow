NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://taskflow:taskflow_secret@localhost:5433/auth_db

# Redis
REDIS_URL=redis://:taskflow_redis@localhost:6380

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-string
JWT_REFRESH_SECRET=change-me-to-another-random-32-char-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
