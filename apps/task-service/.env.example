NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=postgresql://taskflow:taskflow_secret@127.0.0.1:5435/task_db

# Redis
REDIS_URL=redis://:taskflow_redis@127.0.0.1:6380

# RabbitMQ
RABBITMQ_URL=amqp://taskflow:taskflow_rabbit@127.0.0.1:5673/taskflow

# JWT (same as auth-service)
JWT_ACCESS_SECRET=change-me-same-as-auth-service
JWT_ACCESS_EXPIRES_IN=15m

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
