NODE_ENV=development
PORT=3002

# Database
DATABASE_URL=postgresql://taskflow:taskflow_secret@127.0.0.1:5434/user_db

# Redis (for cache)
REDIS_URL=redis://:taskflow_redis@127.0.0.1:6380

# JWT (same as auth-service for token verification)
JWT_ACCESS_SECRET=change-me-same-as-auth-service
JWT_ACCESS_EXPIRES_IN=15m

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
