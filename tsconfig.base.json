{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@taskflow/source"],
    "paths": {
      "@taskflow/shared-types": ["libs/shared-types/src/index.ts"],
      "@taskflow/shared-utils": ["libs/shared-utils/src/index.ts"],
      "@taskflow/auth-lib": ["libs/auth-lib/src/index.ts"]
    }
  }
}
