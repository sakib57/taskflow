{
  "name": "taskflow",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "build:auth": "nx build auth-service",
    "serve:auth": "nx serve auth-service",
    "build:all": "nx run-many --target=build --all",
    "clean": "nx reset && rm -rf dist",
    "clean:dist": "rm -rf dist apps/*/dist libs/*/dist"
  },
  "devDependencies": {
    "@nx/eslint": "20.3.0",
    "@nx/jest": "20.3.0",
    "@nx/js": "20.3.0",
    "@nx/nest": "20.3.0",
    "@nx/node": "20.3.0",
    "@nx/webpack": "20.3.0",
    "@swc/core": "~1.5.7",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.0",
    "jest": "^29.7.0",
    "mongodb": "^6.21.0",
    "nx": "20.3.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4"
  }
}
